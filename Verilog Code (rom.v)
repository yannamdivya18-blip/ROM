module rom (
    input  [2:0] addr,
    output reg [7:0] data
);

always @(*) begin
    case(addr)
        3'b000: data = 8'h11;
        3'b001: data = 8'h22;
        3'b010: data = 8'h33;
        3'b011: data = 8'h44;
        3'b100: data = 8'h55;
        3'b101: data = 8'h66;
        3'b110: data = 8'h77;
        3'b111: data = 8'h88;
        default: data = 8'h00;
    endcase
end

endmodule